# Google Gemini API key used by app/lib/ai.ts (app/api/recommendations).
# Without this set, /api/recommendations automatically falls back to a
# deterministic keyword-matching scorer, so the app still works end-to-end.
GEMINI_API_KEY=

# Optional: override the Gemini model used for recommendations.
# Defaults to "gemini-2.5-flash" if not set.
GEMINI_MODEL=gemini-2.5-flash

# Optional: used for absolute Open Graph / Twitter card URLs in app/layout.tsx.
# Leave unset in local dev; set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=
